# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite WAL and temporary files
*.sqlite3-wal
*.sqlite3-shm

# Snapshot vault data (prevent syncing local machine snapshots)
.fim_vault/*
!.fim_vault/.gitkeep

# Generated local incident reports
generated_reports/*
!generated_reports/.gitkeep

# Environment variables & secrets
.env
.env.local
*.key
*.pem

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store
